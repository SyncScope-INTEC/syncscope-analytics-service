# SyncScope Analytics Service Environment Configuration
# Copy this file to .env and update with your actual values

# Django Configuration
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,analytics.syncscope.dev

# Database Configuration
DATABASE_URL=postgresql://analytics_user:analytics_pass@localhost:5432/analytics_db

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# InfluxDB Configuration (for time series data)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=syncscope
INFLUXDB_BUCKET=analytics-metrics

# External Service URLs
AUTH_SERVICE_URL=http://localhost:8001
MONITORING_SERVICE_URL=http://localhost:8002
MANAGEMENT_SERVICE_URL=http://localhost:8003

# Service Configuration
SERVICE_TIMEOUT=30
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1

# Analytics Configuration
ENABLE_ML_PREDICTIONS=True
CACHE_TIMEOUT=3600
MAX_REPORT_SIZE=10485760
DEFAULT_EXPORT_FORMAT=pdf

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://syncscope.dev
CORS_ALLOW_CREDENTIALS=True

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/analytics.log

# Performance Configuration
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000

# Railway/Production specific (uncomment for production)
# PORT=8000
# RAILWAY_ENVIRONMENT=production